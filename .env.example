# ============================ Analizador de Llamadas IA ============================
# Copie este archivo a `.env` (raíz del proyecto) y ajuste. Nunca suba `.env` al repositorio.

# --- Base de datos / cola -------------------------------------------------------
# Desarrollo local sin Docker: SQLite. Producción: PostgreSQL.
DATABASE_URL=postgresql+psycopg://callan:callan@postgres:5432/callan
REDIS_URL=redis://redis:6379/0
# celery = colas Redis + workers separados (producción) | inline = hilo dentro de la API (desarrollo, sin Redis)
TASK_MODE=celery
INLINE_WORKERS=1

# --- Modelo / dispositivo -------------------------------------------------------
MODEL_NAME=r-f/wav2vec-english-speech-emotion-recognition
MODEL_CACHE_DIR=/data/model_cache
DEVICE=auto                  # auto | cuda | cpu   (auto usa la GPU NVIDIA si existe)
HF_TOKEN=                    # requerido para pyannote.audio (acepte las condiciones de los modelos en Hugging Face)
HF_OFFLINE=false             # true = no descargar; usar solo lo que ya esté en MODEL_CACHE_DIR

# --- Rutas / almacenamiento -----------------------------------------------------
DATA_DIR=/data
UPLOAD_DIR=/data/uploads
REPORT_DIR=/data/reports
MODELS_DIR=/data/models      # modelos entrenados (Model Registry)
TEMP_DIR=/data/tmp
CACHE_DIR=/data/cache
MAX_FILE_SIZE=4294967296     # bytes (4 GB)
STORAGE_BACKEND=local        # local | s3 (MinIO / S3 / compatibles)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=call-analyzer
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=

# --- Seguridad ------------------------------------------------------------------
# Genere valores únicos:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
ENCRYPTION_KEY=              # clave para cifrado en reposo (si vacío se deriva de SECRET_KEY)
ACCESS_TOKEN_MINUTES=480
REFRESH_TOKEN_DAYS=7
ALLOW_SIGNUP=false           # true = cualquiera puede crear una organización nueva
COOKIE_SECURE=false          # true detrás de HTTPS
CORS_ORIGINS=http://localhost:3000
FIRST_ADMIN_EMAIL=admin@empresa.com
FIRST_ADMIN_PASSWORD=cambie-esta-clave

# --- Logging --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Frontend -------------------------------------------------------------------
# URL del backend a la que Next.js reenvía /api/v1/* (se fija en la compilación)
BACKEND_URL=http://backend:8000

# --- Docker Compose -------------------------------------------------------------
POSTGRES_USER=callan
POSTGRES_PASSWORD=callan
POSTGRES_DB=callan
